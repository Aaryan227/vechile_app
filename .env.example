# Application Settings
APP_NAME="Vehicle & Logistics Management System"
API_V1_STR="/api/v1"

# Production Security (Generate a secure secret key via: openssl rand -hex 32)
SECRET_KEY="REPLACE_WITH_SECURE_64_CHAR_HEX_KEY"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Secret Code for Initial Setup / Registration
ADMIN_ACCESS_CODE="REPLACE_WITH_YOUR_PRODUCTION_ADMIN_SECRET"

# Production Database (PostgreSQL recommended)
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/vehicle_logistics_db"

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
